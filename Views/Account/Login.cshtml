@{
    ViewData["Title"] = "Login";
    var seed = ViewBag.Seed as dynamic[];
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card card-pink p-4">
            <h3 class="text-center mb-3">Contract Monthly Claim System</h3>
            <p class="text-center text-muted">Use seeded credentials below for testing</p>

            <form method="post" asp-controller="Account" asp-action="Login">
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input name="Email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input name="Password" type="password" class="form-control" />
                </div>
                <button class="btn btn-pink w-100">Login</button>
            </form>

            <div class="footer-credentials mt-4">
                <h6>Seeded Accounts</h6>
                <ul>
                    @foreach (var s in seed)
                    {
                        <li><strong>@s.Role</strong> — @s.Email / <em>@s.Password</em></li>
                    }
                </ul>
                <small>HR user is configured as a superuser (has all roles)</small>
            </div>
        </div>
    </div>
</div>
