@model ContractClaims.Models.Claim
@{
    ViewData["Title"] = "Submit New Contract Claim";
}

<div class="card card-pink p-4" style="border: 1px solid #D8BFD8;">
    <h2 class="mb-3">Submit New Contract Claim</h2>

    <!-- Show validation errors -->
    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">

        <div class="mb-3">
            <label class="form-label">Hours Worked</label>
            <input asp-for="HoursWorked" class="form-control" />
            <span asp-validation-for="HoursWorked" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Hourly Rate (R)</label>
            <input asp-for="HourlyRate" class="form-control" />
            <span asp-validation-for="HourlyRate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Amount</label>
            <input id="amount" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Upload Supporting Document</label>
            <input type="file" name="upload" class="form-control" required />
            <small class="text-muted">Allowed: .pdf, .docx, .xlsx (Max 5MB)</small>
        </div>

        <div class="mb-3">
            <label class="form-label">Notes (optional)</label>
            <textarea asp-for="Notes" class="form-control"></textarea>
        </div>

        <button type="submit" class="btn btn-pink btn-lg">Submit Claim</button>
    </form>
</div>

@section Scripts {
    <script>
        function calc() {
            let h = parseFloat(document.querySelector('[name="HoursWorked"]').value.replace(",", ".")) || 0;
            let r = parseFloat(document.querySelector('[name="HourlyRate"]').value.replace(",", ".")) || 0;
            document.getElementById('amount').value = (h * r).toFixed(2);
        }

        document.addEventListener("input", function (e) {
            if (e.target.name === "HoursWorked" || e.target.name === "HourlyRate") {
                calc();
            }
        });

        calc();
    </script>
}
