@model ContractClaims.Models.Claim
@{
    ViewData["Title"] = "Submit New Contract Claim";
}

<div class="card-pink">
    <h3>Submit New Contract Claim</h3>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label">Hours Worked</label>
            <input asp-for="HoursWorked" class="form-control" />
            <span asp-validation-for="HoursWorked" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Hourly Rate (R)</label>
            <input asp-for="HourlyRate" class="form-control" />
            <span asp-validation-for="HourlyRate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Amount</label>
            <input id="amount" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Upload Supporting Document</label>
            <input type="file" name="upload" class="form-control" />
            <small class="text-muted">Allowed: .pdf/.docx/.xlsx. Max 5MB.</small>
        </div>

        <div class="mb-3">
            <label class="form-label">Notes (optional)</label>
            <textarea asp-for="Notes" class="form-control"></textarea>
        </div>

        <div class="d-grid">
            <button class="btn btn-pink">Submit Claim</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calc() {
            var h = parseFloat(document.querySelector('[name="HoursWorked"]').value || 0) || 0;
            var r = parseFloat(document.querySelector('[name="HourlyRate"]').value || 0) || 0;
            document.getElementById('amount').value = (h * r).toFixed(2);
        }
        document.addEventListener('input', function(e){
            if (e.target.name === 'HoursWorked' || e.target.name === 'HourlyRate') calc();
        });
        calc();
    </script>
}
