@model ContractClaims.Models.Claim
@{
    ViewData["Title"] = "Claim Details";
}
<div class="card card-pink p-4">
    <h3>Claim #@Model.Id</h3>
    <p><strong>Lecturer:</strong> @Model.Lecturer?.FullName (@Model.Lecturer?.Email)</p>
    <p><strong>Date:</strong> @Model.DateSubmitted.ToString("yyyy-MM-dd")</p>
    <p><strong>Hours:</strong> @Model.HoursWorked</p>
    <p><strong>Rate:</strong> @Model.HourlyRate</p>
    <p><strong>Amount:</strong> @(Model.HoursWorked * Model.HourlyRate)</p>
    <p><strong>Status:</strong> @Model.Status</p>
    <p><strong>Notes:</strong> @Model.Notes</p>
    <p>
        <strong>Document:</strong>
        @if (!string.IsNullOrEmpty(Model.DocumentPath))
        {
            <a href="@Model.DocumentPath" target="_blank">Download</a>
        }
        else
        {
            <span>-</span>
        }
    </p>
</div>

