@model IEnumerable<ContractClaims.Models.Claim>
@{
    ViewData["Title"] = "My Claims";
}

<div class="card-pink">
    <h3>My Claims</h3>

    <table class="table mt-3">
        <thead><tr><th>ID</th><th>Amount</th><th>Hours</th><th>Rate</th><th>Status</th><th>Date</th><th>Document</th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@(c.HoursWorked * c.HourlyRate).ToString("C")</td>
                    <td>@c.HoursWorked</td>
                    <td>@c.HourlyRate.ToString("C")</td>
                    <td>@c.Status</td>
                    <td>@c.DateSubmitted.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(c.DocumentPath))
                        {
                            <a class="btn btn-sm btn-outline-primary" href="@c.DocumentPath">Download</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
