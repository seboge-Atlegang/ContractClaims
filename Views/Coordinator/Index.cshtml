@model IEnumerable<ContractClaims.Models.Claim>
@{
    ViewData["Title"] = "Pending Claims for Review";
}

<h2>@ViewBag.Role - Pending Claims for Review</h2>

<div class="card p-3">
    <table class="table table-responsive">
        <thead style="background:#D8BFD8;color:#222;">
            <tr>
                <th>ID</th>
                <th>Lecturer</th>
                <th>Submitted</th>
                <th>Hours / Rate</th>
                <th>Amount</th>
                <th>Document</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr style="background:@((Model.ToList().IndexOf(c) % 2 == 0) ? "#ffffff" : "#F8F8FF")">
                    <td>@c.Id</td>
                    <td>@c.Lecturer?.FullName</td>
                    <td>@c.DateSubmitted.ToString("yyyy-MM-dd")</td>
                    <td>@c.HoursWorked / @c.HourlyRate.ToString("C")</td>
                    <td>@(c.HoursWorked * c.HourlyRate).ToString("C")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(c.DocumentPath))
                        {
                            <a href="@c.DocumentPath" target="_blank">Download</a>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        <form asp-action="Approve" method="post" style="display:inline;" asp-controller="Coordinator" asp-route-id="@c.Id">
                            <button class="btn" style="background:#C71585;color:#fff;padding:6px 10px;border-radius:6px;">Approve</button>
                        </form>
                        <form asp-action="Reject" method="post" style="display:inline;margin-left:6px;" asp-controller="Coordinator" asp-route-id="@c.Id">
                            <button class="btn" style="background:#F08080;color:#fff;padding:6px 10px;border-radius:6px;">Reject</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
