@model IEnumerable<ContractClaims.Models.ApplicationUser>
@{
    ViewData["Title"] = "HR Dashboard";
}

<div class="hero d-flex justify-content-between align-items-center">
    <div>
        <h2 class="page-title">HR Administration</h2>
        <p class="text-muted">Manage users, claims and reports</p>
    </div>
    <div>
        <span class="role-pill">HR</span>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="stat-card p-3"><div class="stat-label">TOTAL USERS</div><div class="stat-number">@ViewBag.TotalUsers</div></div></div>
    <div class="col-md-3"><div class="stat-card p-3"><div class="stat-label">TOTAL CLAIMS</div><div class="stat-number">@ViewBag.TotalClaims</div></div></div>
    <div class="col-md-3"><div class="stat-card p-3"><div class="stat-label">PENDING CLAIMS</div><div class="stat-number">@ViewBag.PendingClaims</div></div></div>
    <div class="col-md-3"><div class="stat-card p-3"><div class="stat-label">APPROVED</div><div class="stat-number">@ViewBag.ApprovedClaims</div></div></div>
</div>

<div class="d-flex justify-content-between mb-3">
    <div>
        <a class="btn btn-pink" asp-action="Users">Manage Users</a>
        <a class="btn btn-outline-secondary" asp-action="Reports">Reports</a>
    </div>
</div>

<div class="card-pink">
    <h5>Recent Claims</h5>
    <table class="table mt-3">
        <thead><tr><th>ID</th><th>Lecturer</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
        <tbody>
            @foreach (var c in ViewBag.RecentClaims as List<ContractClaims.Models.Claim>)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Lecturer?.FullName</td>
                    <td>@(c.HoursWorked * c.HourlyRate).ToString("C")</td>
                    <td>@c.Status</td>
                    <td>@c.DateSubmitted.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
