@model IEnumerable<ContractClaims.Models.ApplicationUser>
@{
    ViewData["Title"] = "HR Administration Dashboard";
}

<h2>HR Administration Dashboard</h2>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="card card-pink p-3">
            <h5>Total Users</h5>
            <p>@ViewBag.TotalUsers</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-pink p-3">
            <h5>Claims This Month</h5>
            <p>@ViewBag.ClaimsThisMonth</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3" style="border:1px solid #D8BFD8;">
            <a class="btn btn-pink" href="/HR/Reports">Generate Reports</a>
        </div>
    </div>
</div>

<div class="card p-3">
    <h5>Users</h5>
    <table class="table">
        <thead style="background:#D8BFD8;color:#222;">
            <tr><th>Email</th><th>Name</th><th>Hourly Rate</th><th>Roles</th></tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                var app = u as ContractClaims.Models.ApplicationUser;
                <tr style="background:@((Model.ToList().IndexOf(u) % 2 == 0) ? "#ffffff" : "#F8F8FF")">
                    <td>@u.Email</td>
                    <td>@(app?.FullName ?? "-")</td>
                    <td>@(app?.HourlyRate?.ToString("C") ?? "-")</td>
                    <td><!-- optional: show roles via lookup --></td>
                </tr>
            }
        </tbody>
    </table>
</div>
