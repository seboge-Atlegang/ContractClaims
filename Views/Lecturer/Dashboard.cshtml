@model IEnumerable<ContractClaims.Models.Claim>
@{
    ViewData["Title"] = "Lecturer Dashboard";
}

<div class="hero">
    <div>
        <h2 class="page-title">Welcome, @User.Identity.Name</h2>
        <p class="text-muted">Manage your claims and track submissions.</p>
    </div>
    <div>
        <a class="btn btn-pink" asp-controller="Claims" asp-action="Create">Submit New Claim</a>
    </div>
</div>

<div class="card-pink">
    <h5>My Claims</h5>
    <table class="table mt-3">
        <thead><tr><th>ID</th><th>Amount</th><th>Hours</th><th>Rate</th><th>Status</th><th>Date</th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@(c.HoursWorked * c.HourlyRate).ToString("C")</td>
                    <td>@c.HoursWorked</td>
                    <td>@c.HourlyRate.ToString("C")</td>
                    <td>@c.Status</td>
                    <td>@c.DateSubmitted.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
