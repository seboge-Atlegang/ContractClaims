@model IEnumerable<ContractClaims.Models.Claim>
@{
    ViewData["Title"] = "Lecturer Dashboard";
    ViewBag.HeroTitle = $"Welcome back, {User.Identity.Name}!";
    ViewBag.HeroSubtitle = "Manage your claims and track your submissions.";
    ViewBag.RoleName = "Lecturer";
    ViewBag.HeroImageUrl = "/mnt/data/Screenshot 2025-11-21 133628.png";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.Partial("_DashboardHero")

<div class="row stat-row mb-4">
    <div class="col-md-4">
        <div class="card stat-card-accent p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">PENDING CLAIMS</div>
                    <div class="stat-number">@Model.Count(c => c.Status == ContractClaims.Models.ClaimStatus.Pending)</div>
                </div>
                <div><i class="bi bi-clock-history fs-2 text-warning"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card-accent p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">APPROVED CLAIMS</div>
                    <div class="stat-number">@Model.Count(c => c.Status == ContractClaims.Models.ClaimStatus.Approved)</div>
                </div>
                <div><i class="bi bi-check-circle fs-2 text-success"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card-accent p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">TOTAL EARNED</div>
                    <div class="stat-number">
                        @Model.Sum(c => c.HoursWorked * c.HourlyRate).ToString("C")
                    </div>
                </div>
                <div><i class="bi bi-currency-bitcoin fs-2 text-success"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card p-3">
            <div class="d-flex justify-content-between mb-2">
                <h5>Recent Claims</h5>
                <a class="btn btn-outline-secondary" href="/Claims/Index">View All</a>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center p-5">
                    <img src="/mnt/data/Screenshot 2025-11-21 133853.png" alt="no claims" style="height:80px;opacity:.9" />
                    <h5 class="mt-3">No Claims Submitted Yet</h5>
                    <p class="text-muted">Get started by submitting your first claim.</p>
                </div>
            }
            else
            {
                <table class="table">
                    <thead><tr><th>ID</th><th>Amount</th><th>Hours</th><th>Rate</th><th>Status</th><th>Created</th><th>Action</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.Take(5))
                        {
                            var badge = c.Status == ContractClaims.Models.ClaimStatus.Pending ? "badge-pending"
                            : c.Status == ContractClaims.Models.ClaimStatus.Approved ? "badge-approved"
                            : "badge-rejected";
                            <tr>
                                <td>#@c.Id</td>
                                <td>@(c.HoursWorked * c.HourlyRate).ToString("C")</td>
                                <td>@c.HoursWorked</td>
                                <td>@c.HourlyRate.ToString("C")</td>
                                <td><span class="@badge">@c.Status</span></td>
                                <td>@c.DateSubmitted.ToString("MMM d, HH:mm")</td>
                                <td><a class="btn btn-outline-primary" href="/Claims/Details/@c.Id"><i class="bi bi-eye"></i></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 quick-actions">
            <h5>Quick Actions</h5>
            <div class="list-group mt-3">
                <a href="/Claims/Create" class="list-group-item list-group-item-action btn-deeprose text-white">+ Submit New Claim</a>
                <a href="/Claims/Index" class="list-group-item list-group-item-action">View My Claims</a>
                <a href="/Coordinator/Index" class="list-group-item list-group-item-action">Review Pending</a>
                <a href="/HR/Dashboard" class="list-group-item list-group-item-action">Manage Users</a>
            </div>
        </div>
    </div>
</div>
