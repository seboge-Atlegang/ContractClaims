@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>CMCS - @ViewData["Title"]</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css" />

    <!-- Custom Dashboard Theme -->
    <link rel="stylesheet" href="~/css/dashboard-theme.css" />

    <style>
        .navbar-brand {
            font-weight: 700;
            color: #C71585 !important;
            font-size: 1.5rem;
            letter-spacing: 1px;
        }

        .nav-link.active {
            color: #C71585 !important;
            font-weight: 600;
        }

        .top-nav {
            background: #fff;
            border-bottom: 1px solid #eee;
            padding: 10px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }

        .logout-btn {
            border: 1px solid #C71585;
            color: #C71585;
            font-weight: 600;
        }

            .logout-btn:hover {
                background: #C71585;
                color: white;
            }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg top-nav">
            <div class="container-fluid">

                <!-- Brand -->
                <a class="navbar-brand" href="/Home/Index">
                    <i class="bi bi-cash-coin me-1"></i> CMCS
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["Title"]?.ToString()=="Home"?"active":"")"
                               href="/Home/Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>

                        <!-- Submit Claim (Lecturer + HR) -->
                        @if (User.IsInRole("Lecturer") || User.IsInRole("HR"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewData["Title"]?.ToString()=="Submit Claim"?"active":"")"
                                   href="/Claims/Create">
                                    <i class="bi bi-plus-circle"></i> Submit Claim
                                </a>
                            </li>
                        }

                        <!-- My Claims (All Roles) -->
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["Title"]?.ToString()=="My Claims"?"active":"")"
                               href="/Claims/Index">
                                <i class="bi bi-list-ul"></i> My Claims
                            </a>
                        </li>

                        <!-- Coordinator Pending Claims -->
                        @if (User.IsInRole("Coordinator") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewData["Title"]?.ToString()=="Pending Claims"?"active":"")"
                                   href="/Coordinator/Index">
                                    <i class="bi bi-clock-history"></i> Pending Claims
                                </a>
                            </li>
                        }

                        <!-- HR Dashboard -->
                        @if (User.IsInRole("HR"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewData["Title"]?.ToString()=="HR Dashboard"?"active":"")"
                                   href="/HR/Dashboard">
                                    <i class="bi bi-speedometer2"></i> HR Dashboard
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- Profile + Logout -->
                    <ul class="navbar-nav ms-auto">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item me-3 align-self-center">
                                <span class="text-dark fw-semibold">
                                    <i class="bi bi-person-circle"></i>
                                    Hello, @User.Identity?.Name!
                                </span>
                            </li>

                            <li class="nav-item">
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="btn logout-btn">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
